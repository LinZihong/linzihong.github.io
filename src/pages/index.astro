---
import BaseLayout from "../layouts/BaseLayout.astro";

const displayedEmail = "zhLASTNAME at uw.edu";
const cvHref = "/assets/cv/CV%20-%20LIN,%20Zihong.pdf";
---

<BaseLayout title="Home" description="Academic website for Zihong Lin, mathematics PhD student.">
  <section class="hero">
    <div>
      <h1 class="home-title">Zihong Lin</h1>
      <p class="lede">
        I am a third-year mathematics PhD student at the University of Washington.
      </p>
      <p class="lede">
        I am interested in algebraic geometry and its interactions with matroid
        theory and non-archimedean geometry. I am currently working on the
        computations of some KSBA moduli spaces.
      </p>
      <p class="lede">
        Previously, I obtained my BA in Mathematics from Oxford in 2023 and
        completed Part III of the Mathematical Tripos at Cambridge in 2024.
      </p>
    </div>
    <aside class="profile-card" aria-label="Profile summary">
      <img class="profile-photo" src="/assets/images/me.jpeg" alt="Zihong Lin" />
      <p><strong>University of Washington</strong><br />Department of Mathematics</p>
      <p><strong>Email</strong><br />{displayedEmail}</p>
    </aside>
  </section>
</BaseLayout>
